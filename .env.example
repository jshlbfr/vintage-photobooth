# Server-only; copy to .env.local and fill locally. Never use NEXT_PUBLIC_ for secrets.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate two independent random secrets (at least 32 characters each).
SHARE_SIGNING_SECRET=
CRON_SECRET=
# Exact browser origin, without trailing slash. Set your HTTPS origin in deployment.
SHARE_ORIGIN=http://localhost:3000
# Explicit local-only development reward simulation. Keep false in deployment.
REWARD_DEVELOPMENT=false
# Isolated localhost production-build tests ONLY. Never set on a deployed host.
REWARD_LOCAL_TEST=false
